      ITEMS.register();
      BLOCKS.register();
   }

   public static Properties properties(float strength) {
      return properties(strength, strength);
   }

   public static Properties properties(float breakSpeed, float explosionResist) {
      return Properties.m_284310_().m_60913_(breakSpeed, explosionResist);
   }

   private static net.minecraft.world.item.Item.Properties getSettings(Consumer<net.minecraft.world.item.Item.Properties> consumer) {
      net.minecraft.world.item.Item.Properties settings = new net.minecraft.world.item.Item.Properties();
      consumer.accept(settings);
      return settings;
   }

   static net.minecraft.world.item.Item.Properties getSettings() {
      return getSettings((settings) -> {
      });
   }

   private static WineSettings createWineSettings(Supplier<MobEffect> effect, int duration, int strength) {
      return new WineSettings(effect, duration, strength);
   }

   private static RegistrySupplier<Item> registerWineItem(String name, Supplier<Block> wineBlock, Supplier<WineSettings> wineSettings, boolean scaleDurationWithAge, DrinkBlockItem.BottleSize size) {
      return registerItem(name, () -> {
         return new DrinkBlockItem((Block)wineBlock.get(), ((WineSettings)wineSettings.get()).getProperties(), ((WineSettings)wineSettings.get()).getBaseDuration(), scaleDurationWithAge, size);
      });
   }

   private static RegistrySupplier<Item> registerFixedDurationWineItem(String name, Supplier<Block> wineBlock, int fixedDurationTicks, Supplier<MobEffect> effectSupplier, int amplifier, DrinkBlockItem.BottleSize size) {
      return registerItem(name, () -> {
         return new DrinkBlockItem((Block)wineBlock.get(), (new net.minecraft.world.item.Item.Properties()).m_41489_((new Builder()).m_38762_(new MobEffectInstance((MobEffect)effectSupplier.get(), fixedDurationTicks, amplifier), 1.0F).m_38758_(0.3F).m_38765_().m_38767_()), fixedDurationTicks, false, size);
      });
   }

   private static Properties getGrapevineSettings() {
      return Properties.m_284310_().m_60978_(2.0F).m_60977_().m_60918_(SoundType.f_56736_).m_60955_();
   }

   private static Properties getLogBlockSettings() {
      return Properties.m_284310_().m_60978_(2.0F).m_60918_(SoundType.f_56736_);
   }

   private static Properties getWineSettings() {
      return Properties.m_60926_(Blocks.f_50058_).m_60955_().m_60966_();
   }

   private static ButtonBlock woodenButton(FeatureFlag... featureFlags) {
      Properties properties = Properties.m_284310_().m_60910_().m_60978_(0.5F).m_278166_(PushReaction.DESTROY);
      if (featureFlags.length > 0) {
         properties = properties.m_246843_(featureFlags);
      }

      return new ButtonBlock(properties, BlockSetType.f_271401_, 30, true);
   }

   public static <T extends Block> RegistrySupplier<T> registerWithItem(String name, Supplier<T> block) {
      return GeneralUtil.registerWithItem(BLOCKS, BLOCK_REGISTRAR, ITEMS, ITEM_REGISTRAR, Vinery.identifier(name), block);
   }

   public static <T extends Block> RegistrySupplier<T> registerWithoutItem(String path, Supplier<T> block) {
      return GeneralUtil.registerWithoutItem(BLOCKS, BLOCK_REGISTRAR, Vinery.identifier(path), block);
   }

   public static <T extends Item> RegistrySupplier<T> registerItem(String path, Supplier<T> itemSupplier) {
      return GeneralUtil.registerItem(ITEMS, ITEM_REGISTRAR, Vinery.identifier(path), itemSupplier);
   }

   static {
      ITEMS = DeferredRegister.create("vinery", Registries.f_256913_);
      ITEM_REGISTRAR = ITEMS.getRegistrar();
      BLOCKS = DeferredRegister.create("vinery", Registries.f_256747_);
      BLOCK_REGISTRAR = BLOCKS.getRegistrar();
      DARK_CHERRY_SIGN = registerWithoutItem("dark_cherry_sign", () -> {
         return new ModStandingSignBlock(Properties.m_60926_(Blocks.f_50095_), VineryWoodType.DARK_CHERRY);
      });
      DARK_CHERRY_WALL_SIGN = registerWithoutItem("dark_cherry_wall_sign", () -> {
         return new ModWallSignBlock(Properties.m_60926_(Blocks.f_50158_), VineryWoodType.DARK_CHERRY);
      });
      DARK_CHERRY_HANGING_SIGN = registerWithoutItem("dark_cherry_hanging_sign", () -> {
         return new ModHangingSignBlock(Properties.m_60926_(Blocks.f_244319_), VineryWoodType.DARK_CHERRY);
      });
      DARK_CHERRY_WALL_HANGING_SIGN = registerWithoutItem("dark_cherry_wall_hanging_sign", () -> {
         return new ModWallHangingSignBlock(Properties.m_60926_(Blocks.f_244093_), VineryWoodType.DARK_CHERRY);
      });
      DARK_CHERRY_SIGN_ITEM = ITEMS.register("dark_cherry_sign", () -> {
